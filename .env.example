# Neon Postgres connection string
# Get from https://console.neon.tech/ → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Single-user login gate.
# Set ALL THREE to turn it on; leave any unset to keep the app open.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=choose-a-strong-password
# Long random string used to sign the session cookie (32+ characters).
AUTH_SECRET=replace-with-a-long-random-string
